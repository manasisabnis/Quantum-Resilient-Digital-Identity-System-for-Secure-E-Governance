# Quantum-Resilient-Digital - project-wide ignores

# --- Node / JavaScript ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backend-specific node modules (if backend contains a Node project)
backend/node_modules/

# --- Python ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
backend/venv/

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/
eggs/
parts/
sdist/

# Testing / coverage
.pytest_cache/
.mypy_cache/
.coverage
coverage/
htmlcov/

# PyInstaller
#  Usually these files are written by a python script from a template
*.manifest
*.spec

# --- Environment / secrets ---
# dotenv files and other local environment overrides
.env
.env.*
test.env
backend/.env
backend/test.env

# Certificates and keys (common to ignore)
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx

# --- Editor / IDE ---
# Keep extensions.json but ignore other editor settings
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Logs ---
logs/
*.log

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Jupyter ---
.ipynb_checkpoints

# --- Misc / build artifacts ---
*.bak
*.swp
*~
.#*
._*

# Node coverage/nyc
.nyc_output/

# If the repo adds other languages or tools (Maven/Gradle), add ignores as needed
# maven/gradle (uncomment if present)
# target/
# .gradle/

